# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EXTRACTION_MODE: "mock" (deterministic rule-based, no API needed) or "gemini" (LLM extraction via @google/genai)
EXTRACTION_MODE="mock"

# GEMINI_MODEL: Model alias for extraction (default: gemini-3.1-flash-lite)
GEMINI_MODEL="gemini-3.1-flash-lite"

# EXTRACTION_TIMEOUT_MS: Maximum allowed time in milliseconds for extraction calls
EXTRACTION_TIMEOUT_MS="30000"

# ENABLE_SENSITIVE_LOGGING: Set to "true" only in isolated debug environments. Default "false" protects invoice contents.
ENABLE_SENSITIVE_LOGGING="false"

# VITE_API_BASE_URL: Base URL for frontend REST API calls. Leave empty for same-origin (/api/v1).
VITE_API_BASE_URL=""

